<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Profile | CleanCity Connect</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body class="auth-page">

    <!-- Navigation -->
    <nav class="auth-nav">

        <div class="auth-brand">

            <div class="brand-logo">
                🌿
            </div>

            <h2>
                <span>CleanCity</span> Connect
            </h2>

        </div>


        <div class="auth-nav-links">

            <a href="/">Home</a>
            <a href="/#about">About</a>
            <a href="/#features">Features</a>

        </div>


        <div class="auth-nav-actions">

            <% if (currentUser) { %>

                <% if (currentUser.role === "admin") { %>

                    <a href="/admin">Admin Dashboard</a>

                <% } else { %>

                    <a href="/dashboard">Dashboard</a>
                    <a href="/profile">Profile</a>
                    <a href="/report">Report Issue</a>

                <% } %>

                <a href="/logout" class="nav-login-button">
                    Logout
                </a>

            <% } else { %>

                <a href="/login" class="nav-login-button">
                    Login
                </a>

                <a href="/register" class="nav-register-button">
                    Register
                </a>

            <% } %>

        </div>

    </nav>


    <!-- Edit Profile -->
    <main class="profile-edit-modern-page">

        <div class="profile-edit-modern-card">

            <div class="profile-edit-avatar">
                ✏️
            </div>

            <h1>Edit Profile</h1>

            <p class="profile-edit-description">
                Update your personal information
            </p>


            <% if (error) { %>

                <p class="error-message">
                    <%= error %>
                </p>

            <% } %>


            <form action="/profile/edit" method="POST">

                <label for="name">
                    Full Name
                </label>

                <div class="modern-input-box">

                    <span>
                        👤
                    </span>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= user.name %>"
                        placeholder="Enter your full name"
                        required
                    >

                </div>


                <label for="email">
                    Email Address
                </label>

                <div class="modern-input-box">

                    <span>
                        ✉️
                    </span>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= user.email %>"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="profile-edit-actions">

                    <button
                        type="submit"
                        class="profile-save-button"
                    >
                        Save Changes
                    </button>

                    <a
                        href="/profile"
                        class="profile-cancel-button"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

</body>

</html>